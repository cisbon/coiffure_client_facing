# ============================================================
# SalonLyft API Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# ============================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salonlyft
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Open Router API Configuration
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI Model
AI_MODEL=google/gemini-2.5-flash-image

# Application Settings
APP_ENV=production
APP_DEBUG=false

# CORS Settings (comma-separated origins)
# For GitHub Pages, use your actual GitHub Pages URL
ALLOWED_ORIGINS=https://yourusername.github.io,http://localhost:3000

# Default Salon ID (from coiffure_salons table)
DEFAULT_SALON_ID=1

# File Upload Settings
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# Session Settings
SESSION_LIFETIME=3600

# Logging
LOG_ERRORS=true
LOG_PATH=/var/log/salonlyft/

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ============================================================
# Public site URL (used to build wallet + logo links in e-mails)
# ============================================================
APP_PUBLIC_URL=https://clouedo.com/coiffure

# ============================================================
# E-mail delivery
# ============================================================
# From address for the welcome / membership e-mail
MAIL_FROM=noreply@yourdomain.com
MAIL_DOMAIN=yourdomain.com
# Optional SMTP (leave SMTP_HOST empty to use PHP mail())
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# ============================================================
# Digital membership wallet passes
# ============================================================
# Where generated .pkpass files are written
WALLET_PASSES_DIR=
# Pretty base URL for /wallet/{id} (needs a rewrite rule). Leave empty to use
# the directly-working ...api/wallet.php?member_id={id} endpoint instead.
WALLET_BASE_URL=

# --- Apple Wallet (.pkpass signing) ---
# Path to the Pass Type ID certificate (.p12 bundle or combined PEM)
WALLET_APPLE_CERT_PATH=
WALLET_APPLE_CERT_PASSWORD=
# Apple Worldwide Developer Relations intermediate certificate (PEM)
WALLET_APPLE_WWDR_PATH=
WALLET_APPLE_PASS_TYPE_ID=pass.digital.coiffure.membership
WALLET_APPLE_TEAM_ID=

# --- Google Wallet (Save-to-Wallet JWT) ---
WALLET_GOOGLE_ISSUER_ID=
WALLET_GOOGLE_CLASS_ID=
# Path to the Google service account JSON key file
WALLET_GOOGLE_SERVICE_ACCOUNT_JSON=
