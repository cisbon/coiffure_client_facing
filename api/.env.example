# ============================================================
# SalonLyft API Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# ============================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salonlyft
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Open Router API Configuration
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI Model
AI_MODEL=google/gemini-2.5-flash-image

# Application Settings
APP_ENV=production
APP_DEBUG=false

# CORS Settings (comma-separated origins)
# For GitHub Pages, use your actual GitHub Pages URL
ALLOWED_ORIGINS=https://yourusername.github.io,http://localhost:3000

# Default Salon ID (from coiffure_salons table)
DEFAULT_SALON_ID=1

# File Upload Settings
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# Session Settings
SESSION_LIFETIME=3600

# Logging
LOG_ERRORS=true
LOG_PATH=/var/log/salonlyft/

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=3600
